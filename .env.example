# Copy this file to .env and fill in real values to run in LIVE mode.
# If left blank, the pipeline automatically runs in MOCK mode using
# cached/heuristic responses so it works with zero API keys.

OPENAI_API_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Force a mode regardless of keys present: "mock" | "live" | "auto" (default)
TIP_MODE=auto
